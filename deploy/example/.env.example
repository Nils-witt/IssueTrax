# Settings for deploy/example/compose.yaml. Copy to .env (git-ignored) and
# fill in every value; see "Configuration" in the README for details.

# Image tag to run and keep updated: a release such as 1.2 or 1.2.3, or main.
ISSUETRAX_TAG=main

# Generate with: openssl rand -hex 32  (hex keeps it safe inside the DB URL)
POSTGRES_PASSWORD=

ISSUETRAX_PUBLIC_URL=https://trax.example.com
ISSUETRAX_OIDC_ISSUER=https://auth.example.com/application/o/issuetrax/
ISSUETRAX_OIDC_CLIENT_ID=
ISSUETRAX_OIDC_CLIENT_SECRET=
# Generate with: openssl rand -base64 32
ISSUETRAX_COOKIE_KEY=

# ISSUETRAX_LOG_LEVEL=info

# Watchtower update check, 6-field cron (seconds first). Default: daily 04:00.
# WATCHTOWER_SCHEDULE=0 0 4 * * *
# TZ=Europe/Berlin
